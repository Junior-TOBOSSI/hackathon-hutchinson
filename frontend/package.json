{
  "name": "argos-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi/edge.openapi.json -o src/api/generated/edge.ts && openapi-typescript openapi/contracts.openapi.json -o src/api/generated/contracts.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "plotly.js-dist-min": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}

# Copy to .env.local and adapt. Every value below is the default.

# mock = fixtures only (no backend needed) ; live = real Edge / Core APIs
VITE_API_MODE=mock

# Base URLs seen by the browser. Keep the proxied prefixes in development.
VITE_EDGE_API_URL=/edge-api
VITE_CORE_API_URL=/core-api

# Station served by this Operator screen (Edge = one station)
VITE_STATION_ID=WS-01

# Dev-server proxy targets (not exposed to the browser)
EDGE_PROXY_TARGET=http://127.0.0.1:8010
CORE_PROXY_TARGET=http://127.0.0.1:9000

# Copy to .env and adapt:  cp .env.example .env
# Every value below is the default: an empty .env (or no .env at all) gives the demo.

# --- Hardware -------------------------------------------------------------------
# cpu (default, works everywhere) or cuda (optional, needs an NVIDIA GPU + CUDA torch).
# Passed to every analyzer in load(config) as config["device"].
DEVICE=cpu

# --- Image source -----------------------------------------------------------------
# synthetic : images drawn with OpenCV (no camera, no data needed)
# folder    : every image of SOURCE_PATH, in a loop
# video     : the video file SOURCE_PATH, in a loop
# webcam    : the camera WEBCAM_INDEX (not available inside Docker on Windows/macOS)
SOURCE=synthetic
# Path relative to the repository root, e.g. data/test/quality or data/raw/line1.mp4
SOURCE_PATH=
WEBCAM_INDEX=0
SYNTHETIC_SEED=0

# --- Preprocessing (applied before every analyzer) ---------------------------------
# Region of interest in pixels "x,y,w,h"; empty = full image.
ROI=
# Face blurring hook. WARNING: anonymize() is still a stub (no blurring yet).
ANONYMIZE=false

# --- Pipeline ----------------------------------------------------------------------
# Start the analysis loop in the background when the API starts.
PIPELINE_ENABLED=true
# Frames analyzed per second (each frame goes to every enabled analyzer).
PIPELINE_FPS=2
# Comma-separated list among quality, workstation, safety.
ENABLED_USE_CASES=quality,workstation,safety
# Labels written in every event.
WORKSTATION_ID=WS-01
CAMERA_ID=CAM-01

# --- Storage -----------------------------------------------------------------------
# SQLite file for events (no image is ever stored). ":memory:" = nothing written on disk.
DB_PATH=var/events.db

# --- API and dashboard ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
# URL the dashboard uses to reach the API (overridden in docker-compose).
API_URL=http://localhost:8000
# Dashboard auto-refresh period, in seconds.
DASHBOARD_REFRESH_SECONDS=2
